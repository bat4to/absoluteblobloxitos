SpeedLabel.Name = "SpeedLabel"
SpeedLabel.Parent = MainFrame
SpeedLabel.Text = "Speed: " .. Speed
SpeedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedLabel.Size = UDim2.new(1, 0, 0, 20)
SpeedLabel.Position = UDim2.new(0, 0, 0, 35)
SpeedLabel.BackgroundTransparency = 1

SpeedUp.Name = "SpeedUp"
SpeedUp.Parent = MainFrame
SpeedUp.Text = "+"
SpeedUp.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpeedUp.TextColor3 = Color3.fromRGB(0, 255, 0)
SpeedUp.Size = UDim2.new(0, 40, 0, 30)
SpeedUp.Position = UDim2.new(0.2, 0, 0, 60)

SpeedDown.Name = "SpeedDown"
SpeedDown.Parent = MainFrame
