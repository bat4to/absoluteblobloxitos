MainFrame.Size = UDim2.new(0, 150, 0, 170)

Title.Name = "Title"
Title.Parent = MainFrame
Title.Text = "FLY CONTROL"
Title.TextColor3 = Color3.fromRGB(0, 200, 255) -- Azul Cyan
