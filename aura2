SpeedDown.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpeedDown.TextColor3 = Color3.fromRGB(255, 0, 0)
SpeedDown.Size = UDim2.new(0, 40, 0, 30)
SpeedDown.Position = UDim2.new(0.6, 0, 0, 60)

ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = MainFrame
ToggleButton.Text = "FLY: OFF"
ToggleButton.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Size = UDim2.new(0, 120, 0, 35)
ToggleButton.Position = UDim2.new(0.5, -60, 0, 100)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.TextSize = 14

-- Lógica de Voo
local function StopFlying()
    Flying = false
    ToggleButton.Text = "FLY: OFF"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    
    if BodyVelocity then BodyVelocity:Destroy() end
    if BodyGyro then BodyGyro:Destroy() end
end

local function StartFlying()
    Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    RootPart = Character.HumanoidRootPart
    Camera = workspace.CurrentCamera

    -- Limpar instâncias antigas para evitar bugs
    if BodyVelocity then BodyVelocity:Destroy() end
    if BodyGyro then BodyGyro:Destroy() end

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.Parent = RootPart

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.P = 3000
    BodyGyro.CFrame = RootPart.CFrame
    BodyGyro.Parent = RootPart

    Flying = true
    ToggleButton.Text = "FLY: ON"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)

    -- Loop de Movimento
    task.spawn(function()
        while Flying do
            local dt = RunService.RenderStepped:Wait()
            
            local Direction = Vector3.new(0, 0, 0)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                Direction = Direction + Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                Direction = Direction - Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                Direction = Direction - Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                Direction = Direction + Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                Direction = Direction + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                Direction = Direction - Vector3.new(0, 1, 0)
            end

            -- Aplica a velocidade baseada no input e na câmera
            BodyVelocity.Velocity = Direction * Speed
            BodyGyro.CFrame = Camera.CFrame
        end
    end)
end

-- Eventos de Botão
ToggleButton.MouseButton1Click:Connect(function()
    if Flying then
        StopFlying()
    else
        StartFlying()
    end
end)

SpeedUp.MouseButton1Click:Connect(function()
    Speed = Speed + SpeedIncrement
    SpeedLabel.Text = "Speed: " .. Speed
end)

SpeedDown.MouseButton1Click:Connect(function()
    Speed = math.max(5, Speed - SpeedIncrement)
    SpeedLabel.Text = "Speed: " .. Speed
end)

-- Prevenção de erro se o personagem morrer
LocalPlayer.CharacterAdded:Connect(function()
    StopFlying()
end)

print("DeepHat Fly V2 Loaded. Use the UI to fly.")
