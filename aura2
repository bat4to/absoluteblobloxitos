ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0.5, -75, 0, 40) -- Centralizado no topo
MainFrame.Size = UDim2.new(0, 150, 0, 160) -- Aumentado para caber o novo botão

Title.Name = "Title"
Title.Parent = MainFrame
Title.Text = "DEEP HAT FLY"
Title.TextColor3 = Color3.fromRGB(255, 50, 50) -- Vermelho Cyber
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold
Title.Size = UDim2.new(1, 0, 0, 30)
