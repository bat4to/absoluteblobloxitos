Title.Font = Enum.Font.SourceSansBold
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1

SpeedLabel.Name = "SpeedLabel"
SpeedLabel.Parent = MainFrame
SpeedLabel.Text = "Speed: " .. Speed
SpeedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedLabel.Size = UDim2.new(1, 0, 0, 20)
SpeedLabel.Position = UDim2.new(0, 0, 0, 35)
SpeedLabel.BackgroundTransparency = 1

SpeedUp.Name = "SpeedUp"
SpeedUp.Parent = MainFrame
SpeedUp.Text = "+"
SpeedUp.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpeedUp.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedUp.Size = UDim2.new(0, 40, 0, 30)
SpeedUp.Position = UDim2.new(0.2, 0, 0, 60)

SpeedDown.Name = "SpeedDown"
SpeedDown.Parent = MainFrame
SpeedDown.Text = "-"
SpeedDown.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpeedDown.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedDown.Size = UDim2.new(0, 40, 0, 30)
SpeedDown.Position = UDim2.new(0.6, 0, 0, 60)

ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = MainFrame
ToggleButton.Text = "ACTIVATE"
ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255) -- Azul Vibrante
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Size = UDim2.new(0, 120, 0, 40)
ToggleButton.Position = UDim2.new(0.5, -60, 0, 110)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.TextSize = 16

-- Função para desativar o voo e resetar física
local function StopFlying()
    Flying = false
    ToggleButton.Text = "ACTIVATE"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    
    if Humanoid then
        Humanoid.PlatformStand = false -- Devolve o controle ao jogador
    end
    
    if BV then BV:Destroy() end
    if BG then BG:Destroy() end
end

-- Função para ativar o voo
local function StartFlying()
    Character = LocalPlayer.Character
    if not Character then return end
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    Camera = workspace.CurrentCamera

    if not RootPart or not Humanoid then return end

    -- Configura o estado do personagem para não lutar contra a física
    Humanoid.PlatformStand = true 

    -- Criação das forças de movimento
    BV = Instance.new("BodyVelocity")
    BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BV.Velocity = Vector3.new(0, 0, 0)
    BV.Parent = RootPart

    BG = Instance.new("BodyGyro")
    BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BG.P = 3000
    BG.CFrame = RootPart.CFrame
    BG.Parent = RootPart

    Flying = true
    ToggleButton.Text = "DEACTIVATE"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 100, 0) -- Laranja ao ativar

    -- Loop de Movimento Principal
    task.spawn(function()
        while Flying and Character and RootPart do
            RunService.RenderStepped:Wait()
            
            local Direction = Vector3.new(0, 0, 0)
            
            -- Controles de Teclado
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                Direction = Direction + Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                Direction = Direction - Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                Direction = Direction - Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                Direction = Direction + Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                Direction = Direction + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                Direction = Direction - Vector3.new(0, 1, 0)
            end

            -- Aplicação da Velocidade
            BV.Velocity = Direction * Speed
            BG.CFrame = Camera.CFrame -- Mantém o corpo alinhado com a câmera
        end
        
        -- Limpeza final se o loop quebrar
        StopFlying()
    end)
end

-- Eventos de Clique
ToggleButton.MouseButton1Click:Connect(function()
    if Flying then
        StopFlying()
    else
        StartFlying()
    end
end)

SpeedUp.MouseButton1Click:Connect(function()
    Speed = Speed + SpeedIncrement
    SpeedLabel.Text = "Speed: " .. Speed
end)

SpeedDown.MouseButton1Click:Connect(function()
    Speed = math.max(5, Speed - SpeedIncrement)
    SpeedLabel.Text = "Speed: " .. Speed
end)

-- Resetar se morrer
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    StopFlying()
end)

print("DeepHat V3 Engine Ready. Use the Blue Button.")
