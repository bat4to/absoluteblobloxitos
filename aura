-- 2. LÓGICA AVANÇADA

-- Aimbot Melhorado (Usa interpolação de CFrame para evitar snap)
local function UpdateAimbot()
    if not Settings.Aimbot then return end
    
    local target = nil
    local minDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < minDistance then
                    target = p
                    minDistance = dist
                end
            end
        end
    end

    if target and target.Character then
        local targetHRP = target.Character.HumanoidRootPart
        -- Suavização usando Lerp para simular movimento de mão humana
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHRP.Position), Settings.AimbotSmoothness)
    end
end

-- KillAura (Simulação de Combate)
local function UpdateKillAura()
    if not Settings.KillAura then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist <= Settings.KillAuraRange then
                -- Aqui você deve inserir o disparo do RemoteEvent de ataque do jogo
                -- Exemplo: game.ReplicatedStorage.Combat:FireServer("Attack", p.Character)
            end
        end
    end
end

-- Teleport System
local function HandleTeleport()
    if not Settings.TeleportEnabled or Settings.TeleportTarget == "" then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(Settings.TeleportTarget:lower()) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = p.Character.HumanoidRootPart.Position
            local myChar = LocalPlayer.Character
            
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                -- Teleport suave usando Tween para evitar detecção de movimento instantâneo
                local tween = TweenService:Create(myChar.HumanoidRootPart, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))})
                tween:Play()
                print("[DeepHat] Teleportado para: " .. p.Name)
            end
            break
        end
    end
    Settings.TeleportEnabled = false
end

-- 3. LOOP DE EXECUÇÃO (Otimizado)

-- Loop de Física e Movimento (Baixa frequência)
task.spawn(function()
    while true do
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = Settings.WalkSpeed
                hum.JumpPower = Settings.JumpPower
            end
        end
        task.wait(0.5)
    end
end)

-- Loop de Combate (Alta frequência)
RunService.RenderStepped:Connect(function()
    UpdateAimbot()
    UpdateKillAura()
    HandleTeleport()
    
    -- Invisibilidade (Melhorada para partes locais)
    if Settings.Invisibility and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 1
            elseif part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end
end)

