-- Foco: Renderização de UI e Estabilidade de Execução

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

-- [[ 1. CONFIGURAÇÕES (MANTIDAS) ]] --
local Settings = {
    Aimbot = { Enabled = false, Smoothness = 0.12, Range = 150, TargetPart = "Head" },
    KillAura = { Enabled = false, Range = 18, Cooldown = 0.2 },
    Movement = { WalkSpeed = 16, JumpPower = 50, Fly = { Enabled = false, Speed = 50, Key = Enum.KeyCode.F } },
    Troll = { BangEnabled = false, BangTarget = "", TeleportTarget = "", BringEnabled = false, TeleportEnabled = false },
    ESP = { Enabled = false, Color = Color3.fromRGB(255, 0, 255) },
    UI_Open = true
}

-- [[ 2. MÓDULO DE UTILITÁRIOS ]] --
local Utils = {}

function Utils:GetValidCharacter(player)
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character
    end
    return nil
end

-- [[ 3. MÓDULO DE FÍSICA E MOVIMENTO (CORRIGIDO) ]] --
local PhysicsModule = {}
local FlyModule = {}
local bv, bg

function PhysicsModule:Update()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = Settings.Movement.WalkSpeed
        hum.JumpPower = Settings.Movement.JumpPower
        hum.UseJumpPower = true
    end
end

function FlyModule:Toggle(state)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")

    if state then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp

        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 9000
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp

        hum.PlatformStand = true
    else
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        hum.PlatformStand = false
    end
end

function FlyModule:Update()
    if not Settings.Movement.Fly.Enabled or not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local direction = Vector3.new(0, 0, 0)

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direction -= Vector3.new(0, 1, 0) end

    bv.Velocity = direction * Settings.Movement.Fly.Speed
    bg.CFrame = Camera.CFrame
end

-- [[ 4. MÓDULO DE COMBATE E TROLL ]] --
local CombatModule = {}

function CombatModule:UpdateAimbot()
    if not Settings.Aimbot.Enabled then return end
    local target = nil
    local minDistance = Settings.Aimbot.Range

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local mPos = Vector2.new(Mouse.X, Mouse.Y)
                local dist = (Vector2.new(pos.X, pos.Y) - mPos).Magnitude
                if dist < minDistance then
                    target = p
                    minDistance = dist
                end
            end
        end
    end

    if target and target.Character then
        local targetPart = target.Character:FindFirstChild(Settings.Aimbot.TargetPart) or target.Character.HumanoidRootPart
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPart.Position), Settings.Aimbot.Smoothness)
    end
end

local TrollModule = {}

function TrollModule:Bang(targetName)
    if not targetName or targetName == "" then return end
    local target = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(targetName:lower()) then
            target = p
            break
        end
    end

    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetHRP = target.Character.HumanoidRootPart
        local myHRP = LocalPlayer.Character.HumanoidRootPart
        
        task.spawn(function()
            for i = 1, 20 do
                if not Settings.Troll.BangEnabled then break end
                local offset = Vector3.new(0, 0, math.sin(i) * 2.8)
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -1.8) * CFrame.new(offset)
                task.wait(0.04)
            end
        end)
    end
end

-- [[ 5. INTERFACE GUI (RECONSTRUÍDA) ]] --
local function CreateMenu()
