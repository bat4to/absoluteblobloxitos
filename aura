-- 1. CRIAÇÃO DA INTERFACE (GUI) NO CANTO INFERIOR DIREITO
local function CreateMenu()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DeepHat_Menu"
    ScreenGui.Parent = game:GetService("CoreGui") -- Usa CoreGui para não sumir ao morrer

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 180, 0, 250)
    MainFrame.Position = UDim2.new(1, -190, 1, -260) -- Canto inferior direito
    MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true -- Permite mover o menu
    MainFrame.Parent = ScreenGui

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Title.Text = "DEEPHAT MENU"
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.TextSize = 14
    Title.Font = Enum.Font.GothamBold
    Title.Parent = MainFrame

    local Container = Instance.new("ScrollingFrame")
    Container.Size = UDim2.new(1, -10, 1, -40)
    Container.Position = UDim2.new(0, 5, 0, 35)
    Container.BackgroundTransparency = 1
    Container.ScrollBarThickness = 2
    Container.Parent = MainFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = Container
    UIListLayout.Padding = UDim.new(0, 5)

    -- Função para criar botões de Toggle
    local function CreateToggle(name, callback)
        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1, -5, 0, 30)
        Button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        Button.Text = name .. ": OFF"
        Button.TextColor3 = Color3.new(0.8, 0.8, 0.8)
        Button.Font = Enum.Font.Gotham
        Button.TextSize = 12
        Button.Parent = Container

        local enabled = false
        Button.MouseButton1Click:Connect(function()
            enabled = not enabled
            Button.Text = name .. ": " .. (enabled and "ON" or "OFF")
            Button.TextColor3 = enabled and Color3.fromRGB(0, 255, 150) or Color3.new(0.8, 0.8, 0.8)
            callback(enabled)
        end)
    end

    -- Criando as opções no menu
    CreateToggle("Aimbot (R)", function(v) Settings.Aimbot = v end)
    CreateToggle("KillAura (LMB)", function(v) Settings.KillAura = v end)
    CreateToggle("ESP", function(v) Settings.ESP = v end)
    CreateToggle("Hitbox Expander", function(v) Settings.Hitbox = v end)
    CreateToggle("Invisibility", function(v) Settings.Invisibility = v end)
    
    -- Input para Velocidade e Gravidade (Simples)
    local SpeedInput = Instance.new("TextBox")
    SpeedInput.Size = UDim2.new(1, -5, 0, 30)
    SpeedInput.PlaceholderText = "WalkSpeed (Ex: 25)"
    SpeedInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    SpeedInput.TextColor3 = Color3.new(1, 1, 1)
    SpeedInput.Text = "WalkSpeed"
    SpeedInput.Parent = Container
    SpeedInput.FocusLost:Connect(function()
        local val = tonumber(SpeedInput.Text)
        if val then Settings.WalkSpeed = val end
    end)

    return ScreenGui
end

-- 2. LÓGICA DE COMBATE E SISTEMAS (OTIMIZADA)

-- Aimbot com interpolação suave
local function UpdateAimbot()
    if not Settings.Aimbot then return end
    
    local target = nil
    local dist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local screenDist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if screenDist < dist then
                    target = p
                    dist = screenDist
                end
            end
        end
    end

    if target and target.Character then
        local hrp = target.Character.HumanoidRootPart
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, hrp.Position), Settings.AimbotSmoothness)
    end
end

-- Hitbox Expander (Apenas quando ativado)
local function UpdateHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                if Settings.Hitbox then
                    head.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                    head.Transparency = 0.7
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1, 1, 1) -- Tamanho padrão
                    head.Transparency = 0
                end
            end
        end
    end
end

-- 3. LOOP PRINCIPAL (CONTROLE DE PERFORMANCE)
task.spawn(function()
    while task.wait(0.1) do -- Não roda em cada frame para evitar lag
        -- Física
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = Settings.WalkSpeed
            workspace.Gravity = Settings.Gravity
        end

        -- Hitbox e ESP
        UpdateHitboxes()
        
        -- Invisibilidade (Simples)
        if LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = Settings.Invisibility and 1 or 0
                end
            end
        end
    end
end)

