-- [[ BLOBLOXITOS AURA - ULTIMATE STABILITY EDITION ]] --
-- Módulos: Physics, Combat, Troll, Movement, UI

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

-- [[ CONFIGURAÇÕES DE SISTEMA ]] --
local Settings = {
    -- Combate
    Aimbot = false,
    AimbotSmoothness = 0.1,
    AimbotRange = 100,
    KillAura = false,
    KillAuraRange = 15,
    
    -- Movimento (Corrigidos)
    FlyEnabled = false,
    FlySpeed = 50,
    WalkSpeed = 16,
    JumpPower = 50,
    
    -- Troll & Teleport
    BangEnabled = false,
    BangTarget = "",
    TeleportTarget = "",
    TeleportEnabled = false,
    BringEnabled = false,
    
    -- Novos Módulos
    ESP = false,
    AutoClick = false,
    AntiStun = false,
    
    -- UI
    MenuOpen = true
}

-- [[ MÓDULO DE FÍSICA (CORREÇÃO DE VELOCIDADE/PULO) ]] --
local PhysicsModule = {}

function PhysicsModule:Update()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum and hrp then
        -- Aplicação direta e constante para evitar o "reset" do jogo
        hum.WalkSpeed = Settings.WalkSpeed
        hum.JumpPower = Settings.JumpPower
        
        -- Correção de Bug de Gravidade para o Pulo
        if Settings.JumpPower > 0 then
            hum.UseJumpPower = true
        end
    end
end

-- [[ MÓDULO DE VOO (FLY) REFORMULADO ]] --
local FlyModule = {}
local bv, bg

function FlyModule:Toggle(state)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")

    if state then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp

        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 9000
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp

        hum.PlatformStand = true
    else
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        hum.PlatformStand = false
    end
end

function FlyModule:Update()
    if not Settings.FlyEnabled or not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local direction = Vector3.new(0, 0, 0)

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direction -= Vector3.new(0, 1, 0) end

    bv.Velocity = direction * Settings.FlySpeed
    bg.CFrame = Camera.CFrame
end

-- [[ MÓDULO DE TROLL (BANG & BRING) ]] --
local TrollModule = {}

function TrollModule:Bang(targetName)
    if not targetName or targetName == "" then return end
    local target = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(targetName:lower()) then
            target = p
            break
        end
    end

    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetHRP = target.Character.HumanoidRootPart
        local myHRP = LocalPlayer.Character.HumanoidRootPart
        
        task.spawn(function()
            for i = 1, 15 do
                if not Settings.BangEnabled then break end
                local offset = Vector3.new(0, 0, math.sin(i) * 2.5)
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -1.8) * CFrame.new(offset)
                task.wait(0.04)
            end
        end)
    end
end

-- [[ MÓDULO DE COMBATE ]] --
local CombatModule = {}

function CombatModule:UpdateAimbot()
    if not Settings.Aimbot then return end
    local target = nil
    local minDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < minDistance then
                    target = p
                    minDistance = dist
                end
            end
        end
    end

    if target and target.Character then
        local hrp = target.Character.HumanoidRootPart
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, hrp.Position), Settings.AimbotSmoothness)
    end
end

-- [[ INTERFACE GUI (BLOBLOXITOS AURA) ]] --
local function CreateMenu()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "BlobloxitosAura_V4"
    ScreenGui.Parent = game:GetService("CoreGui")

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 220, 0, 380)
    MainFrame.Position = UDim2.new(1, -230, 1, -390)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.BackgroundColor3 = Color3.fromRGB(40, 10, 60)
    Title.Text = "BLOBLOXITOS AURA"
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16
    Title.Parent = MainFrame

    local Container = Instance.new("ScrollingFrame")
    Container.Size = UDim2.new(1, -10, 1, -45)
    Container.Position = UDim2.new(0, 5, 0, 40)
    Container.BackgroundTransparency = 1
    Container.ScrollBarThickness = 2
    Container.Parent = MainFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = Container
    UIListLayout.Padding = UDim.new(0, 6)

    local function AddToggle(name, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, -5, 0, 32)
        Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        Btn.Text = name .. ": OFF"
        Btn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 12
        Btn.Parent = Container

        local state = false
        Btn.MouseButton1Click:Connect(function()
            state = not state
            Btn.Text = name .. ": " .. (state and "ON" or "OFF")
            Btn.TextColor3 = state and Color3.fromRGB(200, 50, 255) or Color3.new(0.8, 0.8, 0.8)
            callback(state)
        end)
    end

    -- Combate
    AddToggle("Aimbot", function(v) Settings.Aimbot = v end)
    AddToggle("KillAura", function(v) Settings.KillAura = v end)
    AddToggle("Fly (Voo)", function(v) Settings.FlyEnabled = v; FlyModule:Toggle(v) end)
    
    -- Troll
    AddToggle("Bang (Troll)", function(v) Settings.BangEnabled = v end)
    
    -- Inputs de Configuração
    local function AddInput(placeholder, callback)
        local Box = Instance.new("TextBox")
        Box.Size = UDim2.new(1, -5, 0, 30)
        Box.PlaceholderText = placeholder
        Box.Text = ""
        Box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        Box.TextColor3 = Color3.new(1, 1, 1)
        Box.Font = Enum.Font.Gotham
        Box.TextSize = 12
        Box.Parent = Container
        Box.FocusLost:Connect(callback)
    end

    AddInput("WalkSpeed", function() Settings.WalkSpeed = tonumber(Box.Text) or 16 end)
    AddInput("JumpPower", function() Settings.JumpPower = tonumber(Box.Text) or 50 end)
    AddInput("Aimbot Smoothness", function() Settings.AimbotSmoothness = tonumber(Box.Text) or 0.1 end)

    -- Teleport/Bring Section
    local NickBox = Instance.new("TextBox")
    NickBox.Size = UDim2.new(1, -5, 0, 30)
    NickBox.PlaceholderText = "Target Nickname"
    NickBox.Text = ""
    NickBox.Parent = Container

    local TPBtn = Instance.new("TextButton")
    TPBtn.Size = UDim2.new(0.48, 0, 0, 30)
    TPBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 80)
    TPBtn.Text = "TP To"
    TPBtn.TextColor3 = Color3.new(1, 1, 1)
    TPBtn.Parent = Container

    local BringBtn = Instance.new("TextButton")
    BringBtn.Size = UDim2.new(0.48, 0, 0, 30)
    BringBtn.Position = UDim2.new(0.52, 0, 0, 0)
    BringBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
    BringBtn.Text = "Bring"
    BringBtn.TextColor3 = Color3.new(1, 1, 1)
    BringBtn.Parent = Container

    TPBtn.MouseButton1Click:Connect(function()
        Settings.TeleportTarget = NickBox.Text
        Settings.TeleportEnabled = true
    end)

    BringBtn.MouseButton1Click:Connect(function()
        Settings.TeleportTarget = NickBox.Text
        Settings.BringEnabled = true
    end)

    return ScreenGui
end

-- [[ LOOP PRINCIPAL DE EXECUÇÃO ]] --

-- Loop de Física e Movimento (Baixa frequência para evitar lag)
task.spawn(function()
    while true do
        PhysicsModule:Update()
        task.wait(0.1)
    end
end)

-- Loop de Combate e Controle (Alta frequência)
RunService.RenderStepped:Connect(function()
    CombatModule:UpdateAimbot()
    FlyModule:Update()
    
    -- Teleport/Bring Logic
    if Settings.TeleportEnabled or Settings.BringEnabled then
        if Settings.TeleportTarget ~= "" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():find(Settings.TeleportTarget:lower()) and p.Character then
                    local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    if targetHRP and myHRP then
                        if Settings.TeleportEnabled then
                            myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 5, 0)
                            Settings.TeleportEnabled = false
                        elseif Settings.BringEnabled then
                            targetHRP.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
                            Settings.BringEnabled = false
                        end
                    end
                    break
                end
            end
        end
    end

    -- Bang Logic
    if Settings.BangEnabled then
        TrollModule:Bang(Settings.TeleportTarget)
    end
end)

-- Inicialização
local Menu = CreateMenu()
print("[Blobloxitos Aura] V4 Carregada. Estabilidade Maximizada.")
