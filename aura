-- 2. LÓGICA DOS SISTEMAS

-- Sistema de Fly (Voo)
local function UpdateFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")

    if Settings.FlyEnabled then
        -- Desativa gravidade local para voar
        hum.PlatformStand = true 
        
        -- Direção baseada na câmera
        local direction = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += Camera.CFrame.RightVector end
        
        hrp.Velocity = direction * Settings.FlySpeed
    else
        hum.PlatformStand = false
    end
end

-- Sistema de Teleport e Bring
local function HandleTeleportation()
    if Settings.TeleportTarget == "" then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(Settings.TeleportTarget:lower()) and p.Character then
            local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            if targetHRP and myHRP then
                if Settings.TeleportEnabled then
                    -- Teleport para o player (Suave)
                    TweenService:Create(myHRP, TweenInfo.new(0.5), {CFrame = targetHRP.CFrame * CFrame.new(0, 5, 0)}):Play()
                    Settings.TeleportEnabled = false
                elseif Settings.BringEnabled then
                    -- Bring: Puxa o player até você (Apenas se você for o dono da ação)
                    -- Nota: Isso funciona melhor em jogos com física fraca
                    TweenService:Create(targetHRP, TweenInfo.new(0.5), {CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)}):Play()
                    Settings.BringEnabled = false
                end
            end
            break
        end
    end
end

-- Aimbot Suave
local function UpdateAimbot()
    if not Settings.Aimbot then return end
    local target = nil
    local minDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < minDistance then
                    target = p
                    minDistance = dist
                end
            end
        end
    end

    if target and target.Character then
        local targetHRP = target.Character.HumanoidRootPart
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHRP.Position), Settings.AimbotSmoothness)
    end
end

-- 3. LOOP PRINCIPAL (Performance)

-- Loop de Física (Baixa frequência)
task.spawn(function()
    while true do
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = Settings.WalkSpeed
                hum.JumpPower = Settings.JumpPower
            end
        end
        task.wait(0.5)
    end
end)

-- Loop de Combate e Movimento (Alta frequência)
RunService.RenderStepped:Connect(function()
    UpdateAimbot()
    HandleTeleportation()
    
    if Settings.FlyEnabled then
        UpdateFly()
    end
    
    -- KillAura (Placeholder para RemoteEvent)
