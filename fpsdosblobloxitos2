-- Lógica Principal de Detecção
RunService.RenderStepped:Connect(function()
    if not Config.Enabled then 
        Dot.Visible = false
        return 
    end

    Dot.Visible = true
    local screenCenter = camera.ViewportSize / 2
    
    -- Desenha o ponto no centro da tela
    Dot.Position = UDim2.new(0, screenCenter.X, 0, screenCenter.Y)

    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local character = p.Character
            local hrp = character.HumanoidRootPart
            
            -- Converte posição do mundo para tela
            local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                
                -- Verifica se está perto o suficiente do centro (Mira)
                if distanceToCenter < Config.FieldOfViewThreshold then
                    -- Verifica visibilidade (Parede)
                    if checkLineOfSight(hrp.Position, character) then
                        closestPlayer = p
                    end
                end
            end
        end
    end
    
    -- Armazena o alvo para o clique
    _G.CurrentTarget = closestPlayer
end)

-- Evento de Clique para Atirar
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 and Config.Enabled then
        if _G.CurrentTarget and _G.CurrentTarget.Character then
            shoot(_G.CurrentTarget.Character.HumanoidRootPart)
        end
    end
end)

