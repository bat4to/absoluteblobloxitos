-- Função para verificar se há obstáculos (Parede)
local function checkLineOfSight(targetPos, character)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {player.Character, targetPos.Parent} -- Ignora o próprio jogador e o alvo para o raio não colidir com ele mesmo imediatamente

    local direction = (targetPos - camera.CFrame.Position).Unit * Config.MaxDistance
    local raycastResult = Workspace:Raycast(camera.CFrame.Position, direction, raycastParams)

    if raycastResult then
        -- Se o raio atingiu algo que não é o personagem alvo, há uma parede
        if raycastResult.Instance:IsDescendantOf(targetPos.Parent) then
            return true -- Visão limpa
        else
            return false -- Há uma parede no caminho
        end
    end
    return true
end

