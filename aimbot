-- ==========================
-- LÓGICA DE AIMBOT
-- ==========================
local function getBestTarget()
    local character = getChar()
    if not character then return nil end
    
    local camPos = camera.CFrame.Position
    local camDir = camera.CFrame.LookVector
    local bestTarget = nil
    local bestScore = math.huge

    for _, otherChar in pairs(Players:GetPlayers()) do
        if otherChar == localPlayer then continue end
        if not otherChar.Character then continue end
        
        local targetChar = otherChar.Character
        local targetPart = targetChar:FindFirstChild(Config.AimPart) or targetChar:FindFirstChild("HumanoidRootPart")
        
        if not targetPart then continue end
        if not isEnemy(targetPart) then continue end
        
        local targetPos = targetPart.Position
        local distance = (camPos - targetPos).Magnitude
        
        if distance > Config.Range then continue end
        
        -- Verifica FOV (ângulo)
        local dirToTarget = (targetPos - camPos)
        if dirToTarget.Magnitude < 0.1 then continue end
        dirToTarget = dirToTarget.Unit
        
        local dot = camDir:Dot(dirToTarget)
        local angle = math.acos(math.clamp(dot, -1, 1)) * (180 / math.pi)
        
        if angle > Config.FOV then continue end
        
        -- Verifica Linha de Visão (Opcional, desativado por padrão para performance, mas pode ser ativado)
        -- if not isLineOfSightClear(camPos, targetPos) then continue end

        -- Score: Distância pesada + Ângulo
        local score = distance + (angle * 10)
        
        if score < bestScore then
            bestTarget = targetPart
            bestScore = score
        end
    end

    return bestTarget
end

local function predictTargetPosition(targetPart, deltaTime)
    local char = targetPart.Parent
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return targetPart.Position end
    
    local velocity = root.AssemblyLinearVelocity
    if velocity.Magnitude < 1 then return targetPart.Position end
    
    local offset = velocity * (Config.PredictionScale * deltaTime)
    return targetPart.Position + offset
end

local function applyAim(targetPart, deltaTime)
    local camPos = camera.CFrame.Position
    local targetPos = targetPart.Position
    
    -- Aplica predição
    if Config.Prediction then
        targetPos = predictTargetPosition(targetPart, deltaTime)
    end
    
    local currentLookAt = camera.CFrame.LookVector
    local desiredLookAt = (targetPos - camPos).Unit
    
    -- Suavização
    local blendFactor = Config.Smoothing
    local smoothedLookAt = currentLookAt * blendFactor + desiredLookAt * (1 - blendFactor)
    smoothedLookAt = smoothedLookAt.Unit
    
    -- Aplica CFrame
    camera.CFrame = CFrame.lookAt(camPos, camPos + smoothedLookAt)
end

local function autoFire()
    local currentTime = tick()
    local fireInterval = 1 / Config.FireRate
    
    if currentTime - state.lastFireTime >= fireInterval then
        local mouse = localPlayer:GetMouse()
        mouse.Button1Down = true
        task.wait(0.01)
        mouse.Button1Down = false
        state.lastFireTime = currentTime
    end
end

-- ==========================
-- LOOP PRINCIPAL
-- ==========================
local lastUpdateTime = tick()

RunService.Heartbeat:Connect(function(deltaTime)
    local currentTime = tick()
    deltaTime = currentTime - lastUpdateTime
    lastUpdateTime = currentTime
    
    if deltaTime > 0.1 then deltaTime = 0.1 end -- Clamp para evitar saltos grandes
    
    -- Atualiza FOV
    updateFOV()
    
    -- Atualiza ESP
    updateESP()
    
    -- Lógica de Aimbot
    if not Config.AimbotEnabled then
        state.currentTarget = nil
        return
    end
    
    local character = getChar()
    if not character then return end
    
    -- Verifica se o alvo atual ainda é válido
    if state.currentTarget then
        if not state.currentTarget.Parent or not state.currentTarget.Parent:FindFirstChildOfClass("Humanoid") then
            state.currentTarget = nil
        end
    end
    
    -- Se não tem alvo, busca o melhor
    if not state.currentTarget then
        state.currentTarget = getBestTarget()
    end
    
    if state.currentTarget then
        applyAim(state.currentTarget, deltaTime)
        
        if Config.AutoFire then
            autoFire()
        end
    end
end)

