local function cleanupESP(character)
    if state.espObjects[character] then
        state.espObjects[character].billboard:Destroy()
        state.espObjects[character].tracer:Destroy()
        state.espObjects[character] = nil
    end
end

local function updateESP()
    -- Limpa ESPs de quem morreu ou saiu
    for char, obj in pairs(state.espObjects) do
        if not char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("Humanoid").Health <= 0 then
            cleanupESP(char)
        end
    end
    
    if not Config.ESPEnabled then return end
    
    local camPos = camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer or not p.Character then continue end
        if not isEnemy(p.Character) then
            -- Opcional: ESP para amigos (apenas cor verde)
            if p.Team == localPlayer.Team then
                local existing = state.espObjects[p.Character]
                if existing then
                    existing.box.BackgroundColor3 = Config.FriendlyColor
                    existing.tracer.Color = ColorSequence.new(Config.FriendlyColor)
                end
            else
                cleanupESP(p.Character)
            end
            continue
        end
        
        local char = p.Character
        local part = char:FindFirstChild(Config.AimPart) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        
        local dist = (camPos - part.Position).Magnitude
        if dist > Config.Range then
            cleanupESP(char)
            continue
        end
        
        local espData = createESP(char)
        if espData then
            espData.box.BackgroundColor3 = Config.ESPColor
            espData.tracer.Color = ColorSequence.new(Config.ESPColor)
            espData.dist.Text = string.format("%.0fm", dist)
            espData.name.Text = p.Name
            -- Atualiza tamanho da caixa baseado em distância
            local scale = math.clamp(50 / (dist / 100), 0.5, 2)
            espData.box.Size = UDim2.new(0, 50 * scale, 0, 50 * scale)
        end
    end
end

