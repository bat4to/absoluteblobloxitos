UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Config.KeyMenu then
        Config.MenuOpen = not Config.MenuOpen
        mainFrame.Visible = Config.MenuOpen
    elseif input.KeyCode == Config.KeyToggleAim then
        Config.AimbotEnabled = not Config.AimbotEnabled
        menuControls.AimToggle.SetValue(Config.AimbotEnabled)
        print(("[CyberAim]: Aimbot %s"):format(Config.AimbotEnabled and "ATIVADO" or "DESATIVADO"))
    elseif input.KeyCode == Config.KeyToggleESP then
        Config.ESPEnabled = not Config.ESPEnabled
        menuControls.ESPToggle.SetValue(Config.ESPEnabled)
        print(("[CyberAim]: ESP %s"):format(Config.ESPEnabled and "ATIVADO" or "DESATIVADO"))
    elseif input.KeyCode == Config.KeyCycleTarget then
        -- Ciclar alvos manualmente
        local currentTarget = state.currentTarget
        local targets = {}
        local character = getChar()
        if not character then return end

        local camPos = camera.CFrame.Position
        local camDir = camera.CFrame.LookVector

        for _, otherChar in pairs(Players:GetPlayers()) do
            if otherChar == localPlayer then continue end
            if not otherChar.Character then continue end
            local targetPart = otherChar.Character:FindFirstChild(Config.AimPart)
            if targetPart and isEnemy(targetPart) then
                local targetPos = targetPart.Position
                local distance = (camPos - targetPos).Magnitude
                local dirToTarget = (targetPos - camPos).Unit
                local angle = math.acos(math.clamp(camDir:Dot(dirToTarget), -1, 1)) * (180 / math.pi)
                
                if distance <= Config.Range and angle <= Config.FOV then
                    table.insert(targets, {part = targetPart, dist = distance})
                end
            end
        end

        table.sort(targets, function(a, b) return a.dist < b.dist end)
        
        if #targets == 0 then
            state.currentTarget = nil
            return
        end

        local currentIndex = 1
        for i, t in ipairs(targets) do
            if t.part == currentTarget then
                currentIndex = i
                break
            end
        end
        
        local nextIndex = (currentIndex % #targets) + 1
        state.currentTarget = targets[nextIndex].part
        print(("[CyberAim]: Alvo alterado para #%d"):format(nextIndex))
    elseif input.KeyCode == Config.KeyReset then
        -- Dispara o reset do botão
        resetBtn.MouseButton1Click:Fire()
    end
end)

