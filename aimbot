-- ==========================
-- UTILITÁRIOS
-- ==========================
local function getChar() return localPlayer.Character end

local function isEnemy(part)
    local char = part.Parent
    if not char or not char:FindFirstChildOfClass("Humanoid") then return false end
    if char == getChar() then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum.Health <= 0 then return false end
    
    local p = Players:GetPlayerFromCharacter(char)
    if not p then return false end
    return p.Team ~= localPlayer.Team
end

local function isLineOfSightClear(fromPos, toPos)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {getChar()}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local dir = toPos - fromPos
    local dist = dir.Magnitude
    local res = workspace:Raycast(fromPos, dir.Unit * dist, rayParams)
    return res == nil or res.Instance.Parent == toPos.Parent
end

