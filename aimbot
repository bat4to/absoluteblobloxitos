local function updateFOV()
    local aspect = camera.ViewportSize.X / camera.ViewportSize.Y
    local fovRad = math.rad(Config.FOV)
    local size = math.tan(fovRad) * aspect * 100
    fovCircle.Size = UDim2.new(0, size, 0, size)
    fovCircle.Visible = Config.AimbotEnabled
