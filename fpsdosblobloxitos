-- [[ fpsdosblobloxitos - FPS Script Framework ]] --
-- Desenvolvido para fins de estudo de lógica de jogos

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = workspace.CurrentCamera

-- Configurações do Usuário
local Settings = {
    ESP_Enabled = false,
    Aimbot_Enabled = false,
    AutoShot_Enabled = false,
    FOV_Radius = 150, -- Tamanho do círculo
    FOV_Color = Color3.fromRGB(255, 255, 255),
    Aimbot_Smoothness = 0.2, -- Suavidade do movimento
    Max_Distance = 500 -- Distância máxima para o ESP
}

-- Variáveis de Controle
local Target = nil
local FOVCircle = Drawing.new("Circle") -- API de desenho para o círculo

-- [[ Inicialização do FOV ]] --
FOVCircle.Visible = true
FOVCircle.Radius = Settings.FOV_Radius
FOVCircle.Color = Settings.FOV_Color
FOVCircle.Thickness = 1
FOVCircle.Transparency = 0.5
FOVCircle.Filled = false

-- [[ Funções de Utilidade ]] --

local function GetClosestPlayerToCursor()
    local ClosestPlayer = nil
    local ShortestDistance = Settings.FOV_Radius

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            
            if onScreen then
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local playerPos = Vector2.new(pos.X, pos.Y)
                local distance = (mousePos - playerPos).Magnitude

                if distance < ShortestDistance then
                    ClosestPlayer = player
                    ShortestDistance = distance
                end
            end
        end
    end
    return ClosestPlayer
end

-- [[ Lógica de ESP ]] --
local function CreateESP(player)
    local function ApplyESP()
        if not Settings.ESP_Enabled or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
        
        -- Simulação de Box ESP (Highlight)
        local Highlight = player.Character:FindFirstChild("ESP_Highlight") or Instance.new("Highlight")
        Highlight.Name = "ESP_Highlight"
        Highlight.FillTransparency = 1
        Highlight.OutlineColor = Color3.new(1, 1, 1) -- Branco
        Highlight.OutlineTransparency = 0
        Highlight.Parent = player.Character
        
        -- Simulação de Nome (BillboardGui)
        local Billboard = player.Character:FindFirstChild("ESP_Name") or Instance.new("BillboardGui")
        Billboard.Name = "ESP_Name"
        Billboard.Size = UDim2.new(0, 100, 0, 50)
        Billboard.StudsOffset = Vector2.new(0, 3)
        Billboard.AlwaysOnTop = true
        Billboard.Parent = player.Character
        
        local Label = Billboard:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        Label.Text = player.Name
        Label.BackgroundTransparency = 1
        Label.TextColor3 = Color3.new(1, 1, 1)
        Label.TextScaled = true
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.Parent = Billboard
    end
    
    task.spawn(function()
        while task.wait() do
            if Settings.ESP_Enabled then ApplyESP() else
                if player.Character and player.Character:FindFirstChild("ESP_Highlight") then
                    player.Character.ESP_Highlight:Destroy()
                end
            end
        end
    end)
end

-- [[ Loop Principal de Combate ]] --
RunService.RenderStepped:Connect(function()
    -- Atualizar posição do círculo para seguir o mouse
    FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
    
    if Settings.Aimbot_Enabled then
        Target = GetClosestPlayerToCursor()
        
        if Target and Target.Character and Target.Character:FindFirstChild("HumanoidRootPart") then
            local TargetPos = Camera:WorldToViewportPoint(Target.Character.HumanoidRootPart.Position)
            local MousePos = Vector2.new(Mouse.X, Mouse.Y)
            
            -- Aimbot (Suavização de movimento)
            local SmoothPos = Vector2.new(
                MousePos.X + (TargetPos.X - MousePos.X) * Settings.Aimbot_Smoothness,
                TargetPos.Y + (TargetPos.Y - MousePos.Y) * Settings.Aimbot_Smoothness
            )
            
            -- Simula mover a câmera/mouse para o alvo
            -- Nota: Em alguns engines, é necessário usar o mouse delta
            -- Para fins de script, simulamos o foco
        end
        
        -- AutoShot (Disparo automático se estiver dentro do círculo central)
        if Settings.AutoShot_Enabled and Target then
            local TargetPos = Camera:WorldToViewportPoint(Target.Character.HumanoidRootPart.Position)
            local MousePos = Vector2.new(Mouse.X, Mouse.Y)
            local DistanceToCenter = (MousePos - Vector2.new(TargetPos.X, TargetPos.Y)).Magnitude
            
            if DistanceToCenter < 10 then -- Margem de erro para o centro
                -- Simula o clique esquerdo
                mouse1click() 
            end
        end
    end
end)

-- [[ Input de Teclado (Tecla G) ]] --
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.G then
        Settings.ESP_Enabled = not Settings.ESP_Enabled
        print("ESP Status: ", Settings.ESP_Enabled)
        
        Settings.Aimbot_Enabled = not Settings.Aimbot_Enabled
        print("Aimbot Status: ", Settings.Aimbot_Enabled)
    end
end)

