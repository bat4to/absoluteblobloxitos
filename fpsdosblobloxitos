-- [[ fpsdosblobloxitos - PRECISION RED ZONE EDITION ]] --
-- Lógica: Aimbot (Círculo Branco) + Triggerbot (Círculo Vermelho)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Configurações de Precisão
local Settings = {
    ESP_Enabled = true,
    Aimbot_Enabled = true,
    Triggerbot_Enabled = true,
    FOV_Radius = 150,        -- Raio do círculo branco (Aimbot)
    Trigger_Radius = 25,     -- Raio do círculo vermelho (Zona de Tiro)
    Aimbot_Smoothness = 0.12, -- Suavidade da puxada da mira
    Color_FOV = Color3.fromRGB(255, 255, 255), -- Branco
    Color_Trigger = Color3.fromRGB(255, 0, 0), -- Vermelho
    Color_Center = Color3.fromRGB(0, 170, 255) -- Azul (Referência)
}

-- Variáveis de Desenho (API de Desenho)
local FOVCircle = Drawing.new("Circle") -- Círculo Branco
FOVCircle.Visible = true
FOVCircle.Radius = Settings.FOV_Radius
FOVCircle.Color = Settings.Color_FOV
FOVCircle.Thickness = 1
FOVCircle.Transparency = 0.4
FOVCircle.Filled = false

local TriggerCircle = Drawing.new("Circle") -- Círculo Vermelho
TriggerCircle.Visible = true
TriggerCircle.Radius = Settings.Trigger_Radius
TriggerCircle.Color = Settings.Color_Trigger
TriggerCircle.Thickness = 2
TriggerCircle.Transparency = 0.6
TriggerCircle.Filled = false

local CenterDot = Drawing.new("Circle") -- Ponto Azul Central
CenterDot.Visible = true
CenterDot.Radius = 2
CenterDot.Color = Settings.Color_Center
CenterDot.Transparency = 1
CenterDot.Filled = true

-- [[ FUNÇÃO PARA ENCONTRAR O ALVO MAIS PRÓXIMO DO CENTRO ]] --
local function GetTarget()
    local ClosestTarget = nil
    local ShortestDistance = Settings.FOV_Radius
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")

            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (ScreenCenter - targetPos).Magnitude

                    -- O alvo deve estar dentro do círculo branco para ser considerado
                    if distance < ShortestDistance then
                        ClosestTarget = player
                        ShortestDistance = distance
                    end
                end
            end
        end
    end
    return ClosestTarget
end

-- [[ SISTEMA DE ESP ]] --
local function ApplyESP(player)
    local function Setup()
        if not player.Character then return end
        local char = player.Character
        
        -- Highlight (Contorno Branco)
        local Highlight = char:FindFirstChild("ESP_Highlight") or Instance.new("Highlight")
        Highlight.Name = "ESP_Highlight"
        Highlight.Parent = char
        Highlight.FillTransparency = 0.7
        Highlight.FillColor = Color3.new(1, 1, 1)
        Highlight.OutlineColor = Color3.new(1, 1, 1)
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        -- Nome
        local Billboard = char:FindFirstChild("ESP_Name") or Instance.new("BillboardGui")
        Billboard.Name = "ESP_Name"
        Billboard.Parent = char
        Billboard.Size = UDim2.new(0, 80, 0, 30)
        Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        Billboard.AlwaysOnTop = true
        
        local Label = Billboard:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        Label.Parent = Billboard
        Label.BackgroundTransparency = 1
        Label.Text = player.Name
        Label.TextColor3 = Color3.new(1, 1, 1)
        Label.TextScaled = true
        Label.Size = UDim2.new(1, 0, 1, 0)
    end
    
    task.spawn(function()
        while task.wait(2) do
            if Settings.ESP_Enabled then Setup() end
        end
    end)
end

-- [[ LOOP PRINCIPAL ]] --
RunService.RenderStepped:Connect(function()
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- Atualiza posições visuais
    FOVCircle.Position = ScreenCenter
    TriggerCircle.Position = ScreenCenter
    CenterDot.Position = ScreenCenter
    
    local TargetPlayer = GetTarget()
    
    if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("Head") then
        local targetHead = TargetPlayer.Character.Head
        local headPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
        
        if onScreen then
            local targetScreenPos = Vector2.new(headPos, 0)
            local distanceToCenter = (ScreenCenter - targetScreenPos).Magnitude
            
            -- 1. LÓGICA DO AIMBOT (Puxa a câmera para o alvo)
            if Settings.Aimbot_Enabled then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHead.Position), Settings.Aimbot_Smoothness)
            end
            
            -- 2. LÓGICA DO TRIGGERBOT (Só atira se estiver na bolinha vermelha)
            if Settings.Triggerbot_Enabled then
                -- Se a distância do centro até a cabeça for menor que o raio da bola vermelha
                if distanceToCenter < Settings.Trigger_Radius then
                    mouse1click() -- Dispara o clique
                end
            end
        end
    end
end)

-- [[ COMANDOS ]] --
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.G then
        Settings.Aimbot_Enabled = not Settings.Aimbot_Enabled
        Settings.Triggerbot_Enabled = not Settings.Triggerbot_Enabled
        print("Aimbot/Trigger: ", Settings.Aimbot_Enabled)
    end
end)

-- [[ INICIALIZAÇÃO ]] --
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then ApplyESP(player) end
end

Players.PlayerAdded:Connect(function(player)
    ApplyESP(player)
end)

print("fpsdosblobloxitos [RED ZONE] Carregado!")
