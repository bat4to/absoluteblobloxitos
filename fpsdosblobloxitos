-- [[ fpsdosblobloxitos - OVERDRIVE EDITION ]] --
-- Foco: Rotação de Ângulo Direta e Trigger por Raycast

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Configurações de Combate Extremo
local Settings = {
    ESP_Enabled = true,
    Aimbot_Enabled = true,
    Triggerbot_Enabled = true,
    FOV_Radius = 150,
    Aimbot_Smoothness = 0.25, -- Quanto maior, mais rápido o giro
    Trigger_Sensitivity = 0.1, -- Sensibilidade do disparo
    Color_FOV = Color3.fromRGB(255, 255, 255),
    Color_Trigger = Color3.fromRGB(255, 0, 0)
}

-- Variáveis de Desenho
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = true
FOVCircle.Radius = Settings.FOV_Radius
FOVCircle.Color = Settings.Color_FOV
FOVCircle.Thickness = 1
FOVCircle.Transparency = 0.3
FOVCircle.Filled = false

local TriggerCircle = Drawing.new("Circle")
TriggerCircle.Visible = true
TriggerCircle.Radius = 20 -- Tamanho da zona de tiro
TriggerCircle.Color = Settings.Color_Trigger
TriggerCircle.Thickness = 2
TriggerCircle.Transparency = 0.5
TriggerCircle.Filled = false

-- [[ FUNÇÃO PARA DETECTAR O ALVO MAIS PRÓXIMO DO CENTRO ]] --
local function GetClosestTarget()
    local ClosestTarget = nil
    local ShortestDistance = Settings.FOV_Radius
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")

            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (ScreenCenter - targetPos).Magnitude
                    if distance < ShortestDistance then
                        ClosestTarget = player
                        ShortestDistance = distance
                    end
                end
            end
        end
    end
    return ClosestTarget
end

-- [[ SISTEMA DE ESP (CONTORNO E NOME) ]] --
local function ApplyESP(player)
    local function Setup()
        if not player.Character then return end
        local char = player.Character
        
        local Highlight = char:FindFirstChild("ESP_Highlight") or Instance.new("Highlight")
        Highlight.Name = "ESP_Highlight"
        Highlight.Parent = char
        Highlight.FillTransparency = 0.7
        Highlight.FillColor = Color3.new(1, 1, 1)
        Highlight.OutlineColor = Color3.new(1, 1, 1)
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        local Billboard = char:FindFirstChild("ESP_Name") or Instance.new("BillboardGui")
        Billboard.Name = "ESP_Name"
        Billboard.Parent = char
        Billboard.Size = UDim2.new(0, 80, 0, 30)
        Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        Billboard.AlwaysOnTop = true
        
        local Label = Billboard:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        Label.Parent = Billboard
        Label.BackgroundTransparency = 1
        Label.Text = player.Name
        Label.TextColor3 = Color3.new(1, 1, 1)
        Label.TextScaled = true
        Label.Size = UDim2.new(1, 0, 1, 0)
    end
    
    task.spawn(function()
        while task.wait(3) do
            if Settings.ESP_Enabled then Setup() end
        end
    end)
end

-- [[ LOOP DE COMBATE (Aimbot de Rotação e Trigger de Raycast) ]] --
RunService.RenderStepped:Connect(function()
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = ScreenCenter
    TriggerCircle.Position = ScreenCenter
    
    local TargetPlayer = GetClosestTarget()
    
    if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("Head") then
        local targetHead = TargetPlayer.Character.Head
        
        -- 1. AIMBOT (Rotação de Câmera Forçada)
        if Settings.Aimbot_Enabled then
            -- Calcula a direção para o alvo
            local targetPos = targetHead.Position
            local currentPos = Camera.CFrame.Position
            
            -- Cria uma nova CFrame olhando para o alvo e aplica suavidade
            local lookAt = CFrame.new(currentPos, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, Settings.Aimbot_Smoothness)
        end
        
        -- 2. TRIGGERBOT (Simulação de Raycast para o Disparo)
        if Settings.Triggerbot_Enabled then
            -- Verifica se o alvo está no centro da tela (dentro do círculo vermelho)
            local headPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
            local targetScreenPos = Vector2.new(headPos, 0)
            local distanceToCenter = (ScreenCenter - targetScreenPos).Magnitude
            
            if distanceToCenter < Settings.Trigger_Radius then
                -- Emula o clique de forma mais agressiva
                mouse1click()
            end
        end
    end
end)

-- [[ COMANDOS ]] --
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.G then
        Settings.Aimbot_Enabled = not Settings.Aimbot_Enabled
        Settings.Triggerbot_Enabled = not Settings.Triggerbot_Enabled
    end
end)

-- [[ INICIALIZAÇÃO ]] --
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then ApplyESP(player) end
end

Players.PlayerAdded:Connect(function(player)
    ApplyESP(player)
end)

print("fpsdosblobloxitos [OVERDRIVE] Carregado!")
