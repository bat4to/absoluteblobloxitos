-- Foco: Detecção via Centro da Tela e AutoShot Contínuo

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Configurações de Combate
local Settings = {
    ESP_Enabled = true,
    Aimbot_Enabled = true,
    AutoShot_Enabled = true,
    FOV_Radius = 180, -- Tamanho do círculo de detecção
    FOV_Color = Color3.fromRGB(255, 255, 255),
    Aimbot_Smoothness = 0.12, -- Menor = mais rápido/travado
    Max_Distance = 1000
}

-- Variáveis de Renderização
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = true
FOVCircle.Radius = Settings.FOV_Radius
FOVCircle.Color = Settings.FOV_Color
FOVCircle.Thickness = 2
FOVCircle.Transparency = 0.5
FOVCircle.Filled = false

-- [[ FUNÇÃO PARA DETECTAR ALVO PELO CENTRO DA TELA ]] --
local function GetClosestTarget()
    local ClosestTarget = nil
    local ShortestDistance = Settings.FOV_Radius
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")

            -- Verifica se o jogador está vivo e tem uma cabeça
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (ScreenCenter - targetPos).Magnitude

                    -- Verifica se o alvo está dentro do raio do círculo (FOV)
                    if distance < ShortestDistance then
                        ClosestTarget = player
                        ShortestDistance = distance
                    end
                end
            end
        end
    end
    return ClosestTarget
end

-- [[ SISTEMA DE ESP (VISUAL) ]] --
local function ApplyESP(player)
    local function Setup()
        if not player.Character then return end
        local char = player.Character
        
        -- Highlight (Caixa Branca)
        local Highlight = char:FindFirstChild("ESP_Highlight") or Instance.new("Highlight")
        Highlight.Name = "ESP_Highlight"
        Highlight.Parent = char
        Highlight.FillTransparency = 0.6
        Highlight.FillColor = Color3.new(1, 1, 1)
        Highlight.OutlineColor = Color3.new(1, 1, 1)
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        -- Nome (Texto)
        local Billboard = char:FindFirstChild("ESP_Name") or Instance.new("BillboardGui")
        Billboard.Name = "ESP_Name"
        Billboard.Parent = char
        Billboard.Size = UDim2.new(0, 100, 0, 50)
        Billboard.StudsOffset = Vector3.new(0, 3, 0)
        Billboard.AlwaysOnTop = true
        
        local Label = Billboard:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        Label.Parent = Billboard
        Label.BackgroundTransparency = 1
        Label.Text = player.Name
        Label.TextColor3 = Color3.new(1, 1, 1)
        Label.TextScaled = true
        Label.Size = UDim2.new(1, 0, 1, 0)
    end
    
    task.spawn(function()
        while task.wait(2) do
            if Settings.ESP_Enabled then
                Setup()
            else
                if player.Character and player.Character:FindFirstChild("ESP_Highlight") then
                    player.Character.ESP_Highlight.Enabled = false
                end
            end
        end
    end)
end

-- [[ LOOP PRINCIPAL (AIMBOT & AUTOSHOT) ]] --
RunService.RenderStepped:Connect(function()
    -- Mantém o círculo sempre no centro da tela
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = ScreenCenter
    
    local TargetPlayer = GetClosestTarget()
    
    if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("Head") then
        local targetHead = TargetPlayer.Character.Head
        
        -- 1. Lógica de Aimbot (Trava a câmera na cabeça)
        if Settings.Aimbot_Enabled then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHead.Position), Settings.Aimbot_Smoothness)
        end
        
        -- 2. Lógica de AutoShot (Clique Infinito)
        if Settings.AutoShot_Enabled then
            -- Simula o clique enquanto o alvo estiver na mira
            mouse1click() 
        end
    end
end)

-- [[ CONTROLES E MENU ]] --
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    
    if input.KeyCode == Enum.KeyCode.G then
        Settings.ESP_Enabled = not Settings.ESP_Enabled
        Settings.Aimbot_Enabled = not Settings.Aimbot_Enabled
        print("Toggle: ESP/AIM ->", Settings.ESP_Enabled)
    end
end)

