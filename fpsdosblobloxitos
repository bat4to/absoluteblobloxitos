    local TargetPlayer = GetClosestTarget()
    
    if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("Head") then
        local targetHead = TargetPlayer.Character.Head
        local headPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
        
        if onScreen then
            -- 1. AIMBOT (Puxada de Câmera Corrigida)
            if Settings.Aimbot_Enabled then
                -- Em vez de apenas Lerp, forçamos a rotação da câmera para o alvo
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Settings.Aimbot_Smoothness)
            end
            
            -- 2. TRIGGERBOT (Detecção de Colisão no Centro)
            if Settings.Triggerbot_Enabled then
                -- Verificamos a posição do mouse real em relação ao alvo
                local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                local targetPos = Vector2.new(headPos, 0)
                local distanceToMouse = (mousePos - targetPos).Magnitude
                
                -- Se o alvo estiver dentro do raio vermelho (perto do mouse/centro)
                if distanceToMouse < Settings.Trigger_Radius then
